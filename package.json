{
  "name": "portfolio",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,ts,html}\" \".prettierrc.json\" \".vscode/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,ts,html}\" \".prettierrc.json\" \".vscode/**/*.json\"",
    "build": "pnpm run format && node scripts/optimize-images.mjs && pnpm run typecheck && vite build",
    "test": "vitest run",
    "preview": "vite preview --host",
    "optimize-images": "node scripts/optimize-images.mjs",
    "lint": "oxlint src scripts tests"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^14.13.0",
    "i18next": "^27.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
